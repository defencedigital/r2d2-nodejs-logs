{
  "compilerOptions": {
    "target": "es2024",
    "module": "commonjs",
    "declaration": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/__tests__/*"]
}
